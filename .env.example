# ============================================
# SERVIDOR
# ============================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Origens de frontends autorizadas, separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Proteção CSRF por token; requer os segredos abaixo quando ativada
CSRF_PROTECTION_ENABLED=false
# Use dois segredos aleatórios e independentes de pelo menos 32 bytes
# CSRF_COOKIE_SECRET=
# CSRF_USER_INFO_HMAC_KEY=
# Use "none" apenas com HTTPS; em produção o cookie sempre usa Secure
CSRF_COOKIE_SAME_SITE=lax

# ============================================
# UPLOADS
# ============================================
UPLOAD_DIR="./uploads"

DATABASE_URL="database url"

JWT_SECRET="jwt token"